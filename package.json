{
  "name": "space-explorer",
  "version": "1.22.0",
  "author": "Douwe de Vries",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "art:export": "bun scripts/exportCinematicAssets.ts",
    "art:evidence": "bun scripts/captureCinematicEvidence.ts",
    "art:shipyard": "bun scripts/shipyard/renderShips.ts",
    "backgrounds:compare": "bun scripts/compareProceduralBackgrounds.ts",
    "test": "bun scripts/run-tests.ts",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.json && node ./node_modules/@typescript/native/bin/tsc -p tsconfig.test.json",
    "typecheck:ts6": "node ./node_modules/typescript/bin/tsc --stableTypeOrdering -p tsconfig.json && node ./node_modules/typescript/bin/tsc --stableTypeOrdering -p tsconfig.test.json",
    "build": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.json && vite build",
    "bundle:report": "bun scripts/bundle-report.ts",
    "bundle:check": "bun scripts/bundle-report.ts --check",
    "architecture:check": "bun scripts/checkArchitecture.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts' '*.{json,js,ts}'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts' '*.{json,js,ts}'",
    "knip": "knip",
    "levels:validate": "bun scripts/validateLevels.ts",
    "backgrounds:record": "bun scripts/recordLivingBackgrounds.ts",
    "test:e2e:game-feel": "GAME_FEEL_EVIDENCE_PORT=4180 playwright test --project=chromium-desktop-game-feel --project=chromium-mobile-game-feel --project=chromium-portrait-game-feel --workers=1",
    "test:e2e": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:performance": "playwright test --project=chromium-performance --workers=1"
  },
  "knip": {
    "entry": [
      "index.html",
      "scripts/**/*.ts",
      "tests/e2e/playerControlsPhysics.ts",
      "tests/e2e/playerBulletPoolProbe.ts",
      "tests/**/*.test.ts"
    ],
    "project": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "scripts/**/*.ts"
    ],
    "ignoreBinaries": [
      "cwebp"
    ]
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/bun": "^1.3.14",
    "@types/three": "0.187.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "three": "0.187.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.6"
  },
  "overrides": {
    "brace-expansion": "5.0.11",
    "nanoid": "3.3.18",
    "zod": "4.6.7",
    "source-map-js": "1.2.2"
  }
}
